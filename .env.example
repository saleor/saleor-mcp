APL_PROVIDER=file
# APL_DYNAMODB_TABLE=saleor-mcp
# AWS_REGION=eu-central-1

# Generate a deployment-specific secret with at least 32 random characters.
MCP_OAUTH_SECRET=replace-with-at-least-32-random-characters

# Required in production. Both are origins, without a trailing path.
APP_API_BASE_URL=http://localhost:3000
APP_IFRAME_BASE_URL=http://localhost:3000

# Optional fallback for a single Dashboard instance. Normally captured from the
# authenticated embedded app parent and stored per installation.
# SALEOR_DASHBOARD_ORIGIN=https://example.saleor.cloud

# Optional full-match regex for Saleor GraphQL installation URLs.
# ALLOWED_DOMAIN_PATTERN=https://[a-z0-9-]+\.saleor\.cloud/graphql/

SALEOR_MCP_MODE=read_only
# SALEOR_MCP_ALLOWED_MUTATIONS=
