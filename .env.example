# Public URL overrides are useful for local tunnels. Leave blank on Vercel.
APP_IFRAME_BASE_URL=
APP_API_BASE_URL=

# Local development uses the template's FileAPL by default.
# Production must choose a persistent APL. The included adapter supports dynamodb.
APL_PROVIDER=file
APL_DYNAMODB_TABLE=
AWS_REGION=

# Required full-match regex listing the Saleor API URLs allowed to install the app.
# Missing or empty configuration rejects every installation.
ALLOWED_DOMAIN_PATTERN=https://api\.example\.com/graphql/

# PEM-encoded RSA keys used only for MCP-facing installation credentials.
# Generate one pair and keep the private key secret. The public key verifies requests.
MCP_CREDENTIAL_PRIVATE_KEY=
MCP_CREDENTIAL_PUBLIC_KEY=

# Deployment-wide safety policy. read_write fails closed unless mutations are allowlisted.
SALEOR_MCP_MODE=read_only
SALEOR_MCP_ALLOWED_MUTATIONS=
